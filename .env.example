# Safe example only. Do not commit real values.

# PostgreSQL / Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Rails/Puma
RAILS_MAX_THREADS=3
JOB_CONCURRENCY=1
PORT=7860
RAILS_LOG_LEVEL=info

# Hugging Face host authorization
SPACE_HOST=your-space-subdomain.hf.space

# Cloudflare R2 authoritative Active Storage originals
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=replace_me
R2_REGION=auto

# Cloudinary D7 derived ActionText mirror
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# Devise/JWT
DEVISE_JWT_SECRET_KEY=replace_with_rails_secret

# Mail defaults
MAILER_SENDER=noreply@example.com
MAIL_FROM_EMAIL=noreply@example.com

# Optional runtime toggle used by Puma configuration
SOLID_QUEUE_IN_PUMA=1
