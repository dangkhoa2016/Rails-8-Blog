# Export required values from your secret manager before running Kamal.
# Never store actual credentials or tokens in this repository.
RAILS_MASTER_KEY=${RAILS_MASTER_KEY:?RAILS_MASTER_KEY is required}
DATABASE_URL=${DATABASE_URL:?DATABASE_URL is required}
DATABASE_URL_UNPOOLED=${DATABASE_URL_UNPOOLED:?DATABASE_URL_UNPOOLED is required}
DEVISE_JWT_SECRET_KEY=${DEVISE_JWT_SECRET_KEY:?DEVISE_JWT_SECRET_KEY is required}
APP_HOST=${APP_HOST:?APP_HOST is required}
R2_ENDPOINT=${R2_ENDPOINT:?R2_ENDPOINT is required}
R2_ACCESS_KEY_ID=${R2_ACCESS_KEY_ID:?R2_ACCESS_KEY_ID is required}
R2_SECRET_ACCESS_KEY=${R2_SECRET_ACCESS_KEY:?R2_SECRET_ACCESS_KEY is required}
R2_BUCKET=${R2_BUCKET:?R2_BUCKET is required}
R2_REGION=${R2_REGION:?R2_REGION is required}
