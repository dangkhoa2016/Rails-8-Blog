<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900"><%= t("admin.audit_logs.title") %></h1>
    <p class="text-gray-600 mt-2"><%= t("admin.audit_logs.subtitle") %></p>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <%= form_with url: admin_audit_logs_path, method: :get, class: "flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center" do |f| %>
      <div class="min-w-0 flex-1">
        <%= f.text_field :ip, placeholder: t("admin.audit_logs.filter_ip"), value: params[:ip], class: "w-full px-4 py-2 border rounded-lg" %>
      </div>
      <div class="min-w-0 flex-1">
        <%= f.select :reason, options_for_select([[t("admin.audit_logs.all"), ""], [t("admin.audit_logs.reasons.throttled"), "throttled"], [t("admin.audit_logs.reasons.blocklisted"), "blocklisted"]], params[:reason]), {}, class: "w-full px-4 py-2 border rounded-lg" %>
      </div>
      <%= f.submit t("admin.audit_logs.filter"), class: "px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
      <%= link_to t("admin.audit_logs.clear"), admin_audit_logs_path, class: "px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300" %>
    <% end %>
  </div>

  <!-- Logs Table -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="w-full overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("admin.audit_logs.time") %></th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("admin.audit_logs.ip") %></th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("admin.audit_logs.path") %></th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("admin.audit_logs.reason") %></th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("admin.audit_logs.user_agent") %></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @blocked_logs.each do |log| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= log.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-gray-900">
              <%= log.ip %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-900">
              <%= log.path %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if log.reason == "throttled" %>
                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">
                  <%= t("admin.audit_logs.reasons.throttled") %>
                </span>
              <% elsif log.reason == "blocklisted" %>
                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">
                  <%= t("admin.audit_logs.reasons.blocklisted") %>
                </span>
              <% else %>
                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">
                  <%= log.reason %>
                </span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500 truncate max-w-xs">
              <%= log.user_agent %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>

    <% if @blocked_logs.empty? %>
      <div class="text-center py-12 text-gray-500">
        <%= t("admin.audit_logs.empty_blocked") %>
      </div>
    <% end %>
  </div>

  <div class="mt-10">
    <div class="mb-4 flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900"><%= t("admin.audit_logs.history") %></h2>
        <p class="text-sm text-gray-600"><%= t("admin.audit_logs.history_subtitle") %></p>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-4 mb-4">
      <%= form_with url: admin_audit_logs_path, method: :get, class: "grid gap-4 sm:grid-cols-3" do |f| %>
        <%= f.text_field :user_id, placeholder: t("admin.audit_logs.user_id"), value: params[:user_id], class: "w-full px-4 py-2 border rounded-lg" %>
        <%= f.select :item_type, options_for_select([[t("admin.audit_logs.all_models"), ""], [t("admin.audit_logs.models.post"), "Post"], [t("admin.audit_logs.models.setting"), "Setting"], [t("admin.audit_logs.models.comment"), "Comment"]], params[:item_type]), {}, class: "w-full px-4 py-2 border rounded-lg" %>
        <div class="flex flex-wrap gap-2">
          <%= f.submit t("admin.audit_logs.filter_history"), class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
          <%= link_to t("admin.audit_logs.clear"), admin_audit_logs_path, class: "px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300" %>
        </div>
      <% end %>
    </div>

    <div class="bg-white rounded-lg shadow overflow-hidden">
      <div class="w-full overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("admin.audit_logs.time") %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("admin.audit_logs.item") %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("admin.audit_logs.event") %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("admin.audit_logs.user") %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t("admin.audit_logs.path") %></th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @versions.each do |version| %>
            <tr>
              <td class="px-6 py-4 text-sm text-gray-700"><%= version.created_at %></td>
              <td class="px-6 py-4 text-sm"><%= link_to "#{version.item_type} ##{version.item_id}", admin_audit_log_path(version), class: "text-primary-600 hover:text-primary-800" %></td>
              <td class="px-6 py-4 text-sm text-gray-700"><%= version.event %></td>
              <td class="px-6 py-4 text-sm text-gray-700"><%= version.whodunnit.presence || "system" %></td>
              <td class="px-6 py-4 text-sm text-gray-500"><%= version.request_path %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      </div>
      <% if @versions.empty? %>
        <div class="py-10 text-center text-gray-500"><%= t("admin.audit_logs.empty_history") %></div>
      <% end %>
    </div>
  </div>

  <!-- Pagination -->
  <% if @pagy.pages > 1 %>
    <div class="mt-6">
      <%== pagy_nav(@pagy) %>
    </div>
  <% end %>
</div>
