<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Audit Logs</h1>
    <p class="text-gray-600 mt-2">Security events and blocked requests</p>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <%= form_with url: admin_audit_logs_path, method: :get, class: "flex gap-4" do |f| %>
      <div class="flex-1">
        <%= f.text_field :ip, placeholder: "Filter by IP", value: params[:ip], class: "w-full px-4 py-2 border rounded-lg" %>
      </div>
      <div class="flex-1">
        <%= f.select :reason, options_for_select([["All", ""], ["Throttled", "throttled"], ["Blocklisted", "blocklisted"]], params[:reason]), {}, class: "w-full px-4 py-2 border rounded-lg" %>
      </div>
      <%= f.submit "Filter", class: "px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
      <%= link_to "Clear", admin_audit_logs_path, class: "px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300" %>
    <% end %>
  </div>

  <!-- Logs Table -->
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Time</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">IP Address</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Path</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Reason</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">User Agent</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @blocked_logs.each do |log| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
              <%= log.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-gray-900">
              <%= log.ip %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-900">
              <%= log.path %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if log.reason == "throttled" %>
                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-yellow-100 text-yellow-800">
                  Throttled
                </span>
              <% elsif log.reason == "blocklisted" %>
                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-red-100 text-red-800">
                  Blocklisted
                </span>
              <% else %>
                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">
                  <%= log.reason %>
                </span>
              <% end %>
            </td>
            <td class="px-6 py-4 text-sm text-gray-500 truncate max-w-xs">
              <%= log.user_agent %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @blocked_logs.empty? %>
      <div class="text-center py-12 text-gray-500">
        No blocked requests found.
      </div>
    <% end %>
  </div>

  <div class="mt-10">
    <div class="mb-4 flex items-center justify-between">
      <div>
        <h2 class="text-2xl font-bold text-gray-900">Change History</h2>
        <p class="text-sm text-gray-600">PaperTrail versions for audited records.</p>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-4 mb-4">
      <%= form_with url: admin_audit_logs_path, method: :get, class: "grid gap-4 sm:grid-cols-3" do |f| %>
        <%= f.text_field :user_id, placeholder: "User ID", value: params[:user_id], class: "w-full px-4 py-2 border rounded-lg" %>
        <%= f.select :item_type, options_for_select([["All models", ""], ["Post", "Post"], ["Setting", "Setting"], ["Comment", "Comment"]], params[:item_type]), {}, class: "w-full px-4 py-2 border rounded-lg" %>
        <div class="flex gap-2">
          <%= f.submit "Filter history", class: "px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
          <%= link_to "Clear", admin_audit_logs_path, class: "px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300" %>
        </div>
      <% end %>
    </div>

    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Time</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Item</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Event</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">User</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Path</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @versions.each do |version| %>
            <tr>
              <td class="px-6 py-4 text-sm text-gray-700"><%= version.created_at %></td>
              <td class="px-6 py-4 text-sm"><%= link_to "#{version.item_type} ##{version.item_id}", admin_audit_log_path(version), class: "text-primary-600 hover:text-primary-800" %></td>
              <td class="px-6 py-4 text-sm text-gray-700"><%= version.event %></td>
              <td class="px-6 py-4 text-sm text-gray-700"><%= version.whodunnit.presence || "system" %></td>
              <td class="px-6 py-4 text-sm text-gray-500"><%= version.request_path %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @versions.empty? %>
        <div class="py-10 text-center text-gray-500">No change history found.</div>
      <% end %>
    </div>
  </div>

  <!-- Pagination -->
  <% if @pagy.pages > 1 %>
    <div class="mt-6">
      <%== pagy_nav(@pagy) %>
    </div>
  <% end %>
</div>
