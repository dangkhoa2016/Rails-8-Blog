<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Audit Logs", admin_audit_logs_path, class: "text-sm font-medium text-primary-600 hover:text-primary-800" %>
    <h1 class="mt-3 text-3xl font-bold text-gray-900">Audit Version</h1>
  </div>

  <dl class="grid gap-4 rounded-lg bg-white p-6 shadow sm:grid-cols-2">
    <div><dt class="text-sm text-gray-500">Item</dt><dd class="font-medium"><%= @version.item_type %> #<%= @version.item_id %></dd></div>
    <div><dt class="text-sm text-gray-500">Event</dt><dd class="font-medium"><%= @version.event %></dd></div>
    <div><dt class="text-sm text-gray-500">User</dt><dd class="font-medium"><%= @version.whodunnit.presence || "system" %></dd></div>
    <div><dt class="text-sm text-gray-500">Time</dt><dd class="font-medium"><%= @version.created_at %></dd></div>
    <div><dt class="text-sm text-gray-500">Request IP</dt><dd class="font-medium"><%= @version.request_ip %></dd></div>
    <div><dt class="text-sm text-gray-500">Request path</dt><dd class="font-medium"><%= @version.request_path %></dd></div>
  </dl>

  <div class="mt-6 rounded-lg bg-white p-6 shadow">
    <h2 class="text-lg font-semibold text-gray-900">Changes</h2>
    <pre class="mt-3 overflow-x-auto whitespace-pre-wrap text-sm text-gray-700"><%= @version.object_changes.presence || "No object changes recorded." %></pre>
  </div>
</div>
