<div class="mb-6 flex items-center justify-between">
  <div>
    <h1 class="text-2xl font-bold text-gray-900"><%= @post.title %></h1>
    <p class="mt-1 text-sm text-gray-600"><%= t("admin.posts.show") %></p>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to edit_admin_post_path(@post), class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
      </svg>
      <%= t("admin.edit") %>
    <% end %>
    <%= link_to admin_posts_path, class: "inline-flex items-center text-sm text-gray-500 hover:text-gray-700" do %>
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      <%= t("admin.back") %>
    <% end %>
  </div>
</div>

<div class="bg-white shadow rounded-lg overflow-hidden">
  <div class="px-6 py-5 border-b border-gray-200 bg-gray-50">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-4">
        <div>
          <span class="text-sm text-gray-500"><%= t("admin.posts.author") %></span>
          <p class="font-medium text-gray-900"><%= @post.user.full_name %></p>
        </div>
        <div class="h-8 w-px bg-gray-300"></div>
        <div>
          <span class="text-sm text-gray-500"><%= t("admin.posts.category") %></span>
          <p class="font-medium text-gray-900"><%= @post.category&.name || "Uncategorized" %></p>
        </div>
        <div class="h-8 w-px bg-gray-300"></div>
        <div>
          <span class="text-sm text-gray-500"><%= t("admin.posts.status") %></span>
          <p>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= status_class(@post.status) %>">
              <%= @post.status %>
            </span>
          </p>
        </div>
        <% if @post.scheduled_at %>
          <div class="h-8 w-px bg-gray-300"></div>
          <div>
            <span class="text-sm text-gray-500"><%= t("admin.posts.scheduled") %></span>
            <p class="font-medium text-gray-900"><%= l(@post.scheduled_at, format: :long) %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="p-6">
    <h3 class="text-lg font-medium text-gray-900 mb-4"><%= t("admin.posts.content") %></h3>
    
    <div class="space-y-6">
      <% I18n.available_locales.each do |locale| %>
        <div class="border border-gray-200 rounded-lg p-4">
          <div class="flex items-center gap-2 mb-3">
            <span class="px-2 py-1 bg-primary-100 text-primary-800 text-xs font-medium rounded">
              <%= locale.upcase %>
            </span>
            <h4 class="font-medium text-gray-900"><%= t("locale.languages.#{locale}") %></h4>
          </div>
          <% if @post.content_for(locale).present? %>
            <div class="prose prose-sm max-w-none text-gray-700">
              <%= @post.content_for(locale) %>
            </div>
          <% else %>
            <p class="text-gray-400 italic"><%= t("admin.posts.no_content") %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
