<div class="container mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900"><%= t("admin.settings.title") %></h1>
    <p class="text-gray-600 mt-2"><%= t("admin.settings.subtitle") %></p>
  </div>

  <%= form_with url: admin_settings_path, method: :patch, class: "space-y-8" do |f| %>
    <% @settings_by_category.each do |category, settings| %>
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-xl font-semibold text-gray-800 mb-4 capitalize"><%= category %></h2>
        
        <div class="space-y-4">
          <% settings.each do |setting| %>
            <div class="border-b border-gray-200 pb-4 last:border-0">
              <label class="block text-sm font-medium text-gray-700 mb-1">
                <%= setting.key %>
                <% if setting.description.present? %>
                  <span class="text-gray-500 font-normal">- <%= setting.description %></span>
                <% end %>
              </label>
              
              <% case setting.value_type %>
              <% when "boolean" %>
                <div class="flex items-center">
                  <%= check_box_tag "settings[#{setting.key}]", "1", setting.typed_value, class: "h-4 w-4 text-blue-600 rounded" %>
                  <span class="ml-2 text-sm text-gray-600">
                    <%= setting.typed_value ? "Enabled" : "Disabled" %>
                  </span>
                </div>
              
              <% when "integer" %>
                <%= number_field_tag "settings[#{setting.key}]", setting.typed_value, class: "w-full px-3 py-2 border rounded-lg" %>
              
              <% when "array", "json" %>
                <%= text_area_tag "settings[#{setting.key}]", setting.value, rows: 3, class: "w-full px-3 py-2 border rounded-lg font-mono text-sm" %>
                <p class="text-xs text-gray-500 mt-1">JSON format</p>
              
              <% else %>
                <%= text_field_tag "settings[#{setting.key}]", setting.typed_value, class: "w-full px-3 py-2 border rounded-lg" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="flex justify-end space-x-4">
      <%= link_to t("common.cancel"), admin_root_path, class: "px-6 py-2 border rounded-lg hover:bg-gray-50" %>
      <%= f.submit t("common.save"), class: "px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700" %>
    </div>
  <% end %>
</div>
