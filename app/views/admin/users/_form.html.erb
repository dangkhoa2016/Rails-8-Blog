<%= form_with(model: [:admin, @user], class: "space-y-6") do |f| %>
  <% if @user.errors.any? %>
    <div class="rounded-md bg-red-50 p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800">
            <%= @user.errors.count %> <%= t("admin.users.errors_prohibited") %>
          </h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%= admin_text_field f, :full_name, label: t("admin.users.full_name"), required: true %>

  <%= admin_email_field f, :email, label: t("admin.users.email"), required: true %>

  <%= admin_select_field f, :role, User::ROLES.map { |r| [r.capitalize, r] }, label: t("admin.users.role") %>

  <%= admin_password_field f, :password, 
        label: t("admin.users.password"), 
        autocomplete: "new-password",
        hint: (@user.persisted? ? t("admin.users.leave_blank") : nil) %>

  <%= admin_password_field f, :password_confirmation, 
        label: t("admin.users.password_confirmation"), 
        autocomplete: "new-password" %>

  <div class="flex items-center justify-end gap-3 pt-4">
    <%= admin_cancel_button t("common.cancel"), admin_users_path %>
    <%= admin_submit_button f, @user.persisted? ? t("admin.users.update") : t("admin.users.create") %>
  </div>
<% end %>
