<section data-testid="categories-index" class="w-full pb-16">
  <h1 class="text-4xl font-bold tracking-tight text-slate-900"><%= t("nav.categories") %></h1>
  <% if @categories.any? %>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @categories.each do |category| %>
        <%= link_to category_path(category, locale: I18n.locale), class: "rounded-2xl border border-slate-200 bg-white p-6 text-lg font-semibold text-slate-900 shadow-sm hover:border-indigo-300 hover:text-indigo-600" do %>
          <%= category.name %>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-6 text-slate-600"><%= t("home.empty_body") %></p>
  <% end %>
</section>
