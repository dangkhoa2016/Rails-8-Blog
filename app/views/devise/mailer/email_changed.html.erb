<p><%= t("mailer.email_changed.hello", email: @email) %></p>

<% if @resource.try(:unconfirmed_email?) %>
  <p><%= t("mailer.email_changed.pending", old_email: @resource.email, new_email: @resource.unconfirmed_email) %></p>
<% else %>
  <p><%= t("mailer.email_changed.updated", email: @resource.email) %></p>
<% end %>
