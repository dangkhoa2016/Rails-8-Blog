<%= render "devise/shared/heading", icon_gradient: "from-blue-50 to-cyan-50", title: t("devise.passwords.new.title"), subtitle: t("devise.passwords.new.subtitle") do %>
  <%= render "devise/shared/icons", icon: :lock %>
<% end %>

<%= render layout: "devise/shared/form_card" do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= render "devise/shared/field", f: f, attribute: :email, type: :email_field, autocomplete: "email", placeholder: t("devise.passwords.new.placeholder_email"), autofocus: true %>

    <%= render "devise/shared/submit_button", f: f, label: t("devise.passwords.new.send_instructions") %>
  <% end %>
<% end %>

<%= render "devise/shared/green_banner",
  title: t("devise.passwords.new.remembered_password"),
  subtitle: t("devise.passwords.new.sign_in_continue") %>

<%= render "devise/shared/action_links", links: [
  { condition: devise_mapping.registerable?, label: t("shared.create_account"), path: new_registration_path(resource_name) },
  { condition: devise_mapping.confirmable?, label: t("devise.links.resend_confirmation"), path: new_confirmation_path(resource_name) },
  { condition: devise_mapping.lockable?, label: t("devise.links.unlock_instructions"), path: new_unlock_path(resource_name) },
] %>
