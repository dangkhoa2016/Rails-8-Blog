<%= render "devise/shared/heading", icon_gradient: "from-violet-50 to-purple-50", title: t("devise.registrations.edit.title"), subtitle: t("devise.registrations.edit.subtitle") do %>
  <%= render "devise/shared/icons", icon: :gear %>
<% end %>

<%= render layout: "devise/shared/form_card" do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="grid grid-cols-2 gap-5 max-sm:grid-cols-1">
      <%= render "devise/shared/field", f: f, attribute: :email, type: :email_field, autocomplete: "email", autofocus: true %>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="flex flex-col col-span-1">
          <p class="text-xs text-slate-300 mt-5"><%= t("devise.registrations.edit.waiting_confirmation") %> <%= resource.unconfirmed_email %></p>
        </div>
      <% end %>

      <% if devise_mapping.password_required? %>
        <%= render "devise/shared/field", f: f, attribute: :password, type: :password_field, autocomplete: "new-password", placeholder: "••••••••", note: t("devise.registrations.edit.leave_blank_note") %>
        <%= render "devise/shared/field", f: f, attribute: :password_confirmation, type: :password_field, autocomplete: "new-password", placeholder: "••••••••" %>
      <% end %>

      <%= render "devise/shared/field", f: f, attribute: :current_password, type: :password_field, autocomplete: "current-password", placeholder: "••••••••", note: t("devise.registrations.edit.current_password_note"), wrapper_class: "col-span-2" %>
    </div>

    <%= render "devise/shared/submit_button", f: f, label: t("devise.registrations.edit.update") %>
  <% end %>
<% end %>

<div class="flex items-center gap-4 my-5">
  <span class="flex-1 h-px bg-slate-200"></span>
  <span class="text-xs text-slate-300"><%= t("devise.registrations.edit.or") %></span>
  <span class="flex-1 h-px bg-slate-200"></span>
</div>

<div class="flex flex-col gap-4">
  <%= button_to t("devise.registrations.edit.cancel_account"), registration_path(resource_name), data: { confirm: t("common.confirm_delete") }, method: :delete, class: "inline-flex items-center justify-center gap-2 px-8 py-3 rounded-lg text-sm font-semibold cursor-pointer transition border bg-red-50 text-red-700 border-red-200 hover:bg-red-100" %>
  <%= link_to "← #{t("common.back")}", :back, class: "text-sm text-indigo-600 no-underline font-medium hover:text-indigo-700 hover:underline" %>
</div>
