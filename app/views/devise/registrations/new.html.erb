<% person_icon = %(<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>).freeze %>
<% mail_icon = %(<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>).freeze %>
<% lock_icon = %(<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>).freeze %>
<% lock_check_icon = %(<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><polyline points="9 12 11 14 15 10"/></svg>).freeze %>
<% pw_hint = t("devise.shared.minimum_password_length", count: Devise.password_length.min) if Devise.password_length.min > 0 %>

<%= render "devise/shared/heading", icon_gradient: "from-indigo-50 to-blue-50", title: "Create account", subtitle: "Join the community and start writing" do %>
  <%= render "devise/shared/icons", icon: :user_plus %>
<% end %>

<%= render layout: "devise/shared/form_card" do %>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="space-y-5">
      <%= render "devise/shared/field", f: f, attribute: :full_name, type: :text_field, autocomplete: "name", placeholder: "John Doe", autofocus: true, leading_icon: person_icon %>
      <%= render "devise/shared/field", f: f, attribute: :email, type: :email_field, autocomplete: "email", placeholder: "you@example.com", leading_icon: mail_icon %>

      <div>
        <div class="space-y-4">
          <%= render "devise/shared/field", f: f, attribute: :password, type: :password_field, autocomplete: "new-password", placeholder: "Create a password", leading_icon: lock_icon, hint: pw_hint %>
          <%= render "devise/shared/field", f: f, attribute: :password_confirmation, type: :password_field, autocomplete: "new-password", placeholder: "Confirm your password", leading_icon: lock_check_icon %>
        </div>
      </div>
    </div>

    <%= render "devise/shared/submit_button", f: f, label: "Sign up" %>
  <% end %>
<% end %>

<%= render "devise/shared/green_banner",
  title: "Already have an account?",
  subtitle: "Sign in to pick up where you left off" %>

<%= render "devise/shared/action_links", links: [
  { condition: devise_mapping.recoverable?, label: "Forgot password?", path: new_password_path(resource_name) },
  { condition: devise_mapping.confirmable?, label: "Resend confirmation", path: new_confirmation_path(resource_name) },
  { condition: devise_mapping.lockable?, label: "Unlock instructions", path: new_unlock_path(resource_name) },
] %>
