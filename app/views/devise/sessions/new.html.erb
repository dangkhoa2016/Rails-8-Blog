<%= render "devise/shared/heading", icon_gradient: "from-indigo-50 to-blue-50", title: "Welcome back", subtitle: "Sign in to pick up where you left off" do %>
  <%= render "devise/shared/icons", icon: :arrow_right %>
<% end %>

<%= render layout: "devise/shared/form_card" do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="grid grid-cols-2 gap-5 max-sm:grid-cols-1">
      <%= render "devise/shared/field", f: f, attribute: :email, type: :email_field, autocomplete: "email", placeholder: "you@example.com", autofocus: true %>
      <%= render "devise/shared/field", f: f, attribute: :password, type: :password_field, autocomplete: "current-password", placeholder: "••••••••" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2 my-2 mb-5">
        <%= f.check_box :remember_me, class: "size-4 accent-indigo-600 cursor-pointer" %>
        <%= f.label :remember_me, "Remember me", class: "text-sm text-slate-600 cursor-pointer" %>
      </div>
    <% end %>

    <%= render "devise/shared/submit_button", f: f, label: "Sign in" %>
  <% end %>
<% end %>

<% if devise_mapping.registerable? %>
  <%= render "devise/shared/green_banner",
    icon_svg: render("devise/shared/icons", icon: :banner_user),
    title: "Don't have an account?",
    subtitle: "Join our community of writers and readers",
    button_label: "Create free account",
    button_path: new_registration_path(resource_name),
    wrapper_class: "min-[1025px]:max-[1110px]:flex-col min-[1025px]:max-[1110px]:text-center",
    text_wrapper_class: "min-[1025px]:max-[1110px]:w-full",
    button_wrapper_class: "min-[1025px]:max-[1110px]:w-full min-[1025px]:max-[1110px]:justify-center",
    button_arrow_class: "min-[1025px]:max-[1110px]:hidden" %>
<% end %>

<%= render "devise/shared/action_links", margin_top: "mt-5", links: [
  { condition: devise_mapping.confirmable?, label: "Resend confirmation", path: new_confirmation_path(resource_name) },
  { condition: devise_mapping.recoverable?, label: "Forgot password?", path: new_password_path(resource_name) },
  { condition: devise_mapping.lockable?, label: "Unlock instructions", path: new_unlock_path(resource_name) },
] %>
