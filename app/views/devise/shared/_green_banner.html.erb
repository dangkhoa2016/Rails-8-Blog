<%# locals: { icon_svg: nil, title:, subtitle:, button_label: "Sign in", button_path: nil, wrapper_class: nil, text_wrapper_class: nil, button_wrapper_class: nil, button_arrow_class: nil } %>
<%
  default_icon = %(<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>).freeze
  resolved_icon        = local_assigns[:icon_svg]
  resolved_path        = local_assigns[:button_path] || new_session_path(resource_name)
  resolved_label       = local_assigns.fetch(:button_label, "Sign in")
  extra_wrapper        = local_assigns[:wrapper_class]
  extra_text_wrapper   = local_assigns[:text_wrapper_class]
  extra_button_wrapper = local_assigns[:button_wrapper_class]
  extra_arrow_class    = local_assigns[:button_arrow_class]

  wrapper_classes        = "flex items-center gap-4 mt-5 p-4 rounded-xl bg-gradient-to-br from-emerald-50 to-green-50 border border-emerald-200 max-sm:flex-col max-sm:text-center"
  wrapper_classes        += " #{extra_wrapper}" if extra_wrapper
  text_wrapper_classes   = "flex items-center gap-3 flex-1 min-w-0 max-sm:flex-col max-sm:gap-2"
  text_wrapper_classes   += " #{extra_text_wrapper}" if extra_text_wrapper
  button_classes         = "inline-flex items-center gap-1.5 flex-shrink-0 px-5 py-2.5 rounded-lg text-sm font-semibold text-white no-underline whitespace-nowrap cursor-pointer transition bg-gradient-to-br from-emerald-600 to-green-500 hover:from-emerald-700 hover:to-green-600 hover:-translate-y-0.5 hover:shadow-lg max-sm:w-full max-sm:justify-center"
  button_classes         += " #{extra_button_wrapper}" if extra_button_wrapper
  arrow_classes          = "max-sm:hidden"
  arrow_classes          += " #{extra_arrow_class}" if extra_arrow_class
%>
<div class="<%= wrapper_classes %>">
  <div class="<%= text_wrapper_classes %>">
    <div class="flex-shrink-0 hidden sm:block">
      <%= (resolved_icon || default_icon).html_safe %>
    </div>
    <div class="flex flex-col gap-0.5">
      <span class="text-sm font-bold text-slate-800 leading-tight"><%= title %></span>
      <span class="text-xs text-slate-400 leading-tight"><%= subtitle %></span>
    </div>
  </div>
  <%= link_to resolved_path, class: button_classes do %>
    <span><%= resolved_label %></span>
    <svg class="<%= arrow_classes %>" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
  <% end %>
</div>
