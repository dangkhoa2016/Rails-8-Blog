<div class="flex flex-wrap gap-x-5 gap-y-3 justify-center" style="margin-top: 1rem;">
  <% if devise_mapping.registerable? && resource.persisted? %>
    <%= link_to "Edit registration", edit_registration_path(resource_name), class: "text-sm text-indigo-600 no-underline font-medium hover:text-indigo-700 hover:underline" %>
  <% end %>

  <% if devise_mapping.confirmable? %>
    <%= link_to "Resend confirmation", new_confirmation_path(resource_name), class: "text-sm text-indigo-600 no-underline font-medium hover:text-indigo-700 hover:underline" %>
  <% end %>

  <% if devise_mapping.recoverable? %>
    <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-sm text-indigo-600 no-underline font-medium hover:text-indigo-700 hover:underline" %>
  <% end %>

  <% if devise_mapping.lockable? %>
    <%= link_to "Resend unlock instructions", new_unlock_path(resource_name), class: "text-sm text-indigo-600 no-underline font-medium hover:text-indigo-700 hover:underline" %>
  <% end %>

  <% if devise_mapping.omniauthable? %>
    <% resource_class.omniauth_providers.each do |provider| %>
      <%= link_to "Sign in with #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), class: "text-sm text-indigo-600 no-underline font-medium hover:text-indigo-700 hover:underline" %>
    <% end %>
  <% end %>
</div>
