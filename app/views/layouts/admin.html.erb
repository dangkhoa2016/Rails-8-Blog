<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full bg-gray-50">
  <head>
    <title><%= "#{t('brand.name')} | #{content_for(:title).presence || t("admin.#{controller_name}.#{action_name}", default: t("admin.#{controller_name}.title", default: t("admin.dashboard.title")))}" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="h-full">
    <div class="min-h-full">
      <% if current_user %>
        <nav data-controller="admin-nav" class="bg-white shadow-sm border-b border-gray-200">
          <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="flex min-h-16 items-center justify-between gap-2">
              <div class="flex min-w-0 items-center">
                <div class="flex flex-shrink-0 items-center">
                  <%= link_to admin_posts_path, class: "whitespace-nowrap text-lg sm:text-xl font-bold text-primary-600 hover:text-primary-700" do %>
                    <svg aria-hidden="true" class="w-8 h-8 inline-block mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                    </svg>
                    <%= t("nav.admin") %>
                  <% end %>
                </div>
                <button type="button" data-admin-nav-target="button" data-action="click->admin-nav#toggle" aria-label="<%= t("admin.navigation.open") %>" aria-expanded="false" aria-controls="admin-navigation-menu" class="ml-2 sm:ml-4 shrink-0 rounded-md p-2 text-gray-700 lg:hidden"><span aria-hidden="true">☰</span></button>
                <div class="hidden lg:ml-8 lg:flex lg:space-x-4">
                  <%= nav_link(t("nav.posts"), admin_posts_path, "article") %>
                  <%= nav_link(t("nav.categories"), admin_categories_path, "folder") %>
                  <%= nav_link(t("nav.tags"), admin_tags_path, "tag") %>
                  <%= nav_link(t("nav.settings"), admin_settings_path, "cog") %>
                  <%= nav_link(t("admin.audit_logs.title"), admin_audit_logs_path, "clipboard") %>
                  <%= nav_link(t("nav.users"), admin_users_path, "users") if current_user.admin? %>
                </div>
              </div>
              <div class="flex min-w-0 items-center gap-2 sm:gap-3">
                <%= link_to localized_root_path(I18n.locale), aria: { label: t("admin.navigation.back_to_site") }, class: "shrink-0 rounded px-1 py-2 text-sm text-gray-500 hover:text-gray-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-indigo-600" do %>
                  <span class="hidden sm:inline"><%= "← #{t('admin.navigation.back_to_site')}" %></span>
                  <span class="sm:hidden" aria-hidden="true">←</span>
                <% end %>
                <div class="relative hidden lg:block" data-controller="locale-dropdown" data-action="keydown.esc@window->locale-dropdown#close">
                  <button type="button" data-locale-dropdown-target="button" data-action="click->locale-dropdown#toggle" aria-label="<%= t("admin.navigation.languages") %>" aria-controls="admin-locale-menu" aria-expanded="false" class="rounded-md border border-gray-200 px-2 py-1 text-xs font-semibold text-gray-700 hover:bg-gray-50"><%= locale_flag_code(I18n.locale) %> ▾</button>
                  <div id="admin-locale-menu" data-locale-dropdown-target="menu" class="hidden absolute right-0 z-50 mt-2 w-48 rounded-lg border border-gray-200 bg-white py-1 shadow-lg">
                    <% available_locales.each do |locale_code| %>
                      <%= link_to locale_name(locale_code), switch_locale_url(locale_code), class: "block px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %>
                    <% end %>
                  </div>
                </div>
                <div class="flex shrink-0 items-center gap-2">
                  <% if current_user.avatar_public_id.present? %>
                    <%= image_tag current_user.avatar_url(size: 32), class: "h-8 w-8 rounded-full object-cover" %>
                  <% else %>
                    <div class="h-8 w-8 rounded-full bg-primary-100 flex items-center justify-center text-primary-600 font-medium text-sm">
                      <%= current_user.full_name.first.upcase %>
                    </div>
                  <% end %>
                  <div class="hidden text-sm sm:block">
                    <p class="font-medium text-gray-900"><%= current_user.full_name %></p>
                    <p class="text-gray-500 text-xs"><%= current_user.role.capitalize %></p>
                  </div>
                </div>
              </div>
            </div>
            <div id="admin-navigation-menu" data-admin-nav-target="menu" data-action="keydown.esc@window->admin-nav#close" class="hidden border-t border-gray-200 py-3 lg:hidden" tabindex="-1"><div class="grid gap-1"><%= link_to t("nav.posts"), admin_posts_path, class: "rounded px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %><%= link_to t("nav.categories"), admin_categories_path, class: "rounded px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %><%= link_to t("nav.tags"), admin_tags_path, class: "rounded px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %><%= link_to t("nav.settings"), admin_settings_path, class: "rounded px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %><%= link_to t("admin.audit_logs.title"), admin_audit_logs_path, class: "rounded px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" %><%= link_to t("nav.users"), admin_users_path, class: "rounded px-3 py-2 text-sm text-gray-700 hover:bg-gray-50" if current_user.admin? %></div>
              <div class="mt-3 border-t border-gray-200 pt-3">
                <p class="mb-2 px-3 text-xs font-semibold text-gray-500"><%= t("admin.navigation.languages") %></p>
                <div class="flex flex-wrap gap-2 px-3">
                  <% available_locales.each do |locale_code| %>
                    <%= link_to locale_flag_code(locale_code), switch_locale_url(locale_code), aria: { label: locale_name(locale_code) }, class: "rounded border border-gray-200 px-2 py-1 text-xs #{I18n.locale == locale_code ? 'bg-indigo-50 text-indigo-700' : 'text-gray-600'}" %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </nav>
      <% end %>

      <main class="py-10">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <% if notice = flash[:notice] %>
            <div class="rounded-md bg-green-50 p-4 mb-6">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm font-medium text-green-800"><%= notice %></p>
                </div>
              </div>
            </div>
          <% end %>

          <% if alert = flash[:alert] %>
            <div class="rounded-md bg-red-50 p-4 mb-6">
              <div class="flex">
                <div class="flex-shrink-0">
                  <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <div class="ml-3">
                  <p class="text-sm font-medium text-red-800"><%= alert %></p>
                </div>
              </div>
            </div>
          <% end %>

          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
