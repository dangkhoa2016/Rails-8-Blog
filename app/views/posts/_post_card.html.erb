<article data-testid="post-card" class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
  <% if post.cloudinary_public_id.present? %>
    <%= image_tag post.thumbnail_url(width: 960, height: 540, crop: :fill), alt: "", class: "aspect-video w-full object-cover" %>
  <% else %>
    <div data-testid="post-image-fallback" class="aspect-video bg-gradient-to-br from-indigo-100 via-slate-100 to-slate-200" aria-hidden="true"></div>
  <% end %>
  <div class="p-6">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900"><%= link_to post.title, post_path(post, locale: I18n.locale), class: "hover:text-indigo-600" %></h2>
    <% if post.content_for(I18n.locale).present? %>
      <p class="mt-3 line-clamp-3 text-slate-600"><%= post.content_for(I18n.locale).to_plain_text.truncate(180) %></p>
    <% end %>
    <div class="mt-5"><%= render "posts/post_meta", post: post %></div>
  </div>
</article>
