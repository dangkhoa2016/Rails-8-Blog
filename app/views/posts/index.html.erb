<% content_for :title, t("posts.title") %>

<div class="w-full space-y-8 pb-16">
  <header class="max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600"><%= t("brand.name") %></p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900"><%= t("posts.title") %></h1>
  </header>

  <% if @posts.any? %>
    <div class="grid gap-6 lg:grid-cols-2"><%= render partial: "posts/post_card", collection: @posts, as: :post %></div>
    <% if @pagy.pages > 1 %>
      <div class="flex justify-center"><%== @pagy.series_nav(aria_label: t("posts.pagination")) %></div>
    <% end %>
  <% else %>
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
      <p class="text-lg font-semibold text-slate-900"><%= t("posts.empty_title") %></p>
      <p class="mt-2 text-slate-600"><%= t("posts.empty_body") %></p>
    </div>
  <% end %>
</div>
