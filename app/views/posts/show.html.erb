<% content_for :title, @post.title %>

<article data-testid="post-detail" class="mx-auto w-full max-w-3xl pb-16">
  <% if @post.cloudinary_public_id.present? %>
    <%= image_tag @post.thumbnail_url(width: 1440, height: 810, crop: :fill), alt: "", class: "mb-10 aspect-video w-full rounded-2xl object-cover" %>
  <% else %>
    <div data-testid="post-image-fallback" class="mb-10 aspect-video w-full rounded-2xl bg-gradient-to-br from-indigo-100 via-slate-100 to-slate-200" aria-hidden="true"></div>
  <% end %>
  <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600"><%= @post.category.name %></p>
  <h1 class="mt-3 text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl"><%= @post.title %></h1>
  <div class="mt-6"><%= render "posts/post_meta", post: @post %></div>
  <div class="prose prose-slate mt-10 max-w-none"><%= @post.content_for(I18n.locale) %></div>

  <% if @post.slides.any? %>
    <section data-testid="post-slideshow" aria-label="Slideshow" class="mt-10 space-y-6">
      <% @post.slides.each do |slide| %>
        <figure class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
          <%= image_tag slide.image,
                alt: slide.alt_text_for(I18n.locale).to_s,
                class: "aspect-video w-full object-cover" %>
          <% if (caption = slide.caption_for(I18n.locale)).present? %>
            <figcaption class="px-4 py-3 text-sm text-slate-700"><%= caption %></figcaption>
          <% end %>
        </figure>
      <% end %>
    </section>
  <% end %>

  <section aria-labelledby="engagement-heading" class="mt-12 space-y-8 border-t border-slate-200 pt-8">
    <h2 id="engagement-heading" class="text-2xl font-bold text-slate-900"><%= t("engagement.title") %></h2>
    <% if user_signed_in? %>
      <div>
        <p class="text-sm font-medium text-slate-700"><%= @current_reaction ? t("engagement.current_reaction", kind: @current_reaction.kind) : t("engagement.no_reaction") %></p>
        <div class="mt-3 flex flex-wrap gap-2">
          <% %w[like love].each do |kind| %>
            <%= button_to t("engagement.reactions.#{kind}"), post_reactions_path(@post, locale: I18n.locale), params: { kind: kind }, class: "rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" %>
          <% end %>
          <% if @current_reaction %><%= button_to t("engagement.remove_reaction"), post_reaction_path(@post, @current_reaction, locale: I18n.locale), method: :delete, class: "rounded-lg text-sm font-semibold text-rose-700" %><% end %>
        </div>
      </div>
      <%= form_with model: Comment.new, url: post_comments_path(@post, locale: I18n.locale), class: "space-y-3" do |form| %>
        <%= form.label :body, t("engagement.comment_label"), class: "block text-sm font-semibold text-slate-700" %>
        <%= form.text_area :body, rows: 4, class: "w-full rounded-lg border border-slate-300 p-3" %>
        <%= form.submit t("engagement.post_comment"), class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white" %>
      <% end %>
    <% else %>
      <p class="text-slate-600"><%= link_to t("shared.sign_in"), new_user_session_path(locale: I18n.locale), class: "font-semibold text-indigo-600" %> <%= t("engagement.sign_in_prompt") %></p>
    <% end %>
    <div class="space-y-4">
      <% @comments.each do |comment| %><article class="rounded-xl bg-slate-100 p-4"><p class="font-semibold text-slate-900"><%= comment.user.full_name %></p><p class="mt-1 text-slate-700"><%= comment.display_body %></p></article><% end %>
    </div>
  </section>
  <div class="mt-12 border-t border-slate-200 pt-6"><%= link_to t("posts.back"), posts_path(locale: I18n.locale), class: "text-sm font-semibold text-indigo-600 hover:text-indigo-700" %></div>
</article>
