<% content_for :title, t("home.title") %>

<div class="w-full space-y-16 pb-16">
  <section class="rounded-3xl border border-slate-200 bg-white px-6 py-12 shadow-sm sm:px-12">
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600"><%= t("brand.tagline") %></p>
    <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl"><%= t("home.hero_title") %></h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600"><%= t("home.hero_body") %></p>
    <div class="mt-8 flex flex-wrap gap-3">
      <%= link_to t("home.explore_posts"), posts_path(locale: I18n.locale), class: "rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700" %>
      <%= link_to t("home.browse_topics"), categories_path(locale: I18n.locale), class: "rounded-lg border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50" %>
    </div>
  </section>

  <section aria-labelledby="recent-posts-heading">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600"><%= t("home.recent_eyebrow") %></p>
        <h2 id="recent-posts-heading" class="mt-2 text-3xl font-bold tracking-tight text-slate-900"><%= t("home.recent_posts") %></h2>
      </div>
      <%= link_to t("home.view_all"), posts_path(locale: I18n.locale), class: "hidden text-sm font-semibold text-indigo-600 hover:text-indigo-700 sm:block" %>
    </div>

    <% if @recent_posts.any? %>
      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <% @recent_posts.each do |post| %>
          <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <p class="text-sm font-medium text-indigo-600"><%= post.category.name %></p>
            <h3 class="mt-3 text-xl font-bold text-slate-900"><%= link_to post.title, post_path(post, locale: I18n.locale), class: "hover:text-indigo-600" %></h3>
            <p class="mt-3 text-sm text-slate-600"><%= t("home.byline", author: post.user.full_name) %></p>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="mt-8 rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
        <p class="text-lg font-semibold text-slate-900"><%= t("home.empty_title") %></p>
        <p class="mt-2 text-slate-600"><%= t("home.empty_body") %></p>
      </div>
    <% end %>
  </section>
</div>
