<section data-testid="tag-show" class="w-full space-y-8 pb-16">
  <header>
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600"><%= t("nav.tags") %></p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-900"><%= @tag.name %></h1>
  </header>
  <% if @posts.any? %>
    <div class="grid gap-6 lg:grid-cols-2"><%= render partial: "posts/post_card", collection: @posts, as: :post %></div>
    <% if @pagy.pages > 1 %><div class="flex justify-center"><%== @pagy.series_nav(aria_label: t("posts.pagination")) %></div><% end %>
  <% else %>
    <p class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center text-slate-600"><%= t("posts.empty_body") %></p>
  <% end %>
</section>
