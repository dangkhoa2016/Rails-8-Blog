#!/bin/bash -e

if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  : "${DATABASE_URL:?DATABASE_URL is required for production server boot}"
  : "${DATABASE_URL_UNPOOLED:?DATABASE_URL_UNPOOLED is required for production database preparation}"

  DATABASE_URL="${DATABASE_URL_UNPOOLED}" ./bin/rails db:prepare
fi

exec "${@}"
